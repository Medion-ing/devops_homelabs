.molecule/


#################################################
# OpenTofu / Terraform
#################################################

# Provider cache
**/.terraform/

# State files (NEVER commit)
**/*.tfstate
**/*.tfstate.*
**/*.tfstate.backup

# Variables contenant des secrets
**/*.tfvars
**/*.tfvars.json
**/*.auto.tfvars
**/*.auto.tfvars.json

# Plans
**/*.tfplan
**/*.plan

# Logs
crash.log
crash.*.log
*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


#################################################
# Docker
#################################################

# Docker env
docker/**/.env
docker/**/env

# Volumes persistants
docker/**/data/
docker/**/volumes/

# Logs
docker/**/logs/


